fr {
    solyton {
        user {
            managementPage {
                title: "Gestion des utilisateurs"
                buttons {
                    createUser {
                        title: "Créer un utilisateur"
                    }
                }
                dialogs {
                    createUser {
                        title: "Créer un utilisateur"
                        inputs {
                            username {
                                title: "Nom d'utilisateur"
                            }
                            password {
                                title: "Mot de passe"
                                hint: "Le mot de passe doit contenir au moins 8 caractères,"
                            }
                            repeatPassword{
                                title: "Répéter le mot de passe"
                            }
                        }
                        okButton {
                            title: "Ok"
                        }
                        cancelButton {
                            title: "Annuler"
                        }
                        errors {
                            wrongPassword: "Mot de passe incorrect"
                            requirementsViolated: "Exigences du mot de passe non respectées"
                            repeatedPasswordMismatch: "Les mots de passe ne correspondent pas"
                            newPasswordEqualsOld: "Le nouveau mot de passe doit être différent de l'ancien"
                        }
                    }
                }
                registeredUsers {
                    title: "Utilisateurs enregistrés"
                    buttons {
                        edit {
                            title: "Modifier"
                        }
                        delete {
                            title: "Supprimer"
                        }
                    }
                }
                permissions {
                    title: "Autorisations"
                    table {
                        title: "Rôles dans les contextes"
                        columns {
                            context {
                                title: "Contexte"
                            }
                            roles {
                                title: "Rôles"
                            }
                        }
                    }
                }
            }
            privatePage {
                title: "Données personnelles"
                buttons {
                    changePassword {
                        title: "Modifier le mot de passe"
                    }
                    changeUsername {
                        title: "Modifier le nom d'utilisateur"
                    }
                personalData {
                    title: "Vos données"
                    properties {
                        username{
                            value: "Nom d'utilisateur"
                        }
                        firstname {
                            value: "Prénom"
                        }
                        lastname {
                            value: "Nom"
                        }
                        title {
                            value: "Titre"
                        }
                        address {
                            value: "Adresse"
                        }
                    }
                }
                permissions {
                    title: "Autorisations"
                    table {
                        title: "Rôles dans les contextes"
                        columns {
                            context {
                                title: "Contexte"
                            }
                            roles {
                                title: "Rôles"
                            }
                            rights {
                                title: "Droits"
                            }
                        }
                    }
                }
                dialogs {
                    updateUser {
                        title: "Mettre à jour l'utilisateur"
                        subTitle: "Modifier le nom d'utilisateur ou le mot de passe"
                        inputs {
                            username {
                                title: "Nom d'utilisateur"
                            }
                            oldPassword {
                                title: "Ancien mot de passe"
                            }
                            newPassword {
                                title: "Nouveau mot de passe"
                            }
                            repeatPassword {
                                title: "Répéter le mot de passe"
                            }
                        }
                        hints {
                            title: "Indications"
                            authenticationRequired: "Authentification requise. Vous devez fournir votre mot de passe actuel pour modifier votre nom d'utilisateur ou votre mot de passe."
                            loginCredentialsChanged: "Modifier votre nom d'utilisateur ou votre mot de passe modifiera vos identifiants de connexion."
                        }
                        errors {
                            wrongPassword: "Mot de passe incorrect"
                            requirementsViolated: "Exigences du mot de passe non respectées"
                            repeatedPasswordMismatch: "Les mots de passe ne correspondent pas"
                            newPasswordEqualsOld: "Le nouveau mot de passe doit être différent de l'ancien"
                        }
                        okButton {
                            title: "Ok"
                        }
                        cancelButton {
                            title: "Annuler"
                        }
                    }

                    changePassword {
                        title: "Modifier le mot de passe"
                        inputs {
                            oldPassword {
                                title: "Ancien mot de passe"
                            }
                            newPassword {
                                title: "Nouveau mot de passe"
                            }
                            repeatPassword {
                                title: "Répéter le mot de passe"
                            }
                        }
                        errors {
                            wrongPassword: "Mot de passe incorrect"
                            requirementsViolated: "Exigences du mot de passe non respectées"
                            repeatedPasswordMismatch: "Les mots de passe ne correspondent pas"
                            newPasswordEqualsOld: "Le nouveau mot de passe doit être différent de l'ancien"
                        }
                        okButton {
                            title: "Ok"
                        }
                        cancelButton {
                            title: "Annuler"
                        }
                    }
                    updateUserProfile {
                        title: "Modifier le profil utilisateur"
                        inputs {
                         userProfile {
                             formTitle: "Données personnelles"
                             username {
                                title: "E-mail"
                             }
                             firstname {
                                 title: "Prénom"
                             }
                             lastname {
                                 title: "Nom"
                             }
                             title {
                                title: "Titre"
                             }
                             phoneNumber {
                                title: "Téléphone"
                             }
                             cellPhoneNumber {
                                title: "Téléphone portable"
                             }
                             address {
                                title: "Adresse"
                                recipientName {
                                    title: "Destinataire"
                                }
                                organizationName {
                                    title: "Société / Organisation"
                                }
                                addressLine1 {
                                    title: "Rue, N°"
                                }
                                addressLine2 {
                                    title: "Ligne d'adresse 2"
                                }
                                city {
                                    title: "Ville"
                                }
                                stateOrProvince {
                                    title: "État / Province"
                                }
                                postalCode {
                                    title: "Code postal"
                                }
                                countryCode {
                                    title: "Pays"
                                }
                             }
                         }
                        }
                        okButton {
                            title: "Ok"
                        }
                        cancelButton {
                            title: "Annuler"
                        }
                    }
                }
            }
        }
    }
}
